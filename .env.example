# Обязательно: токен бота MAX
BOT_TOKEN=

# Обязательно: производный ключ из токена (64 hex-символа).
# Получить: cd backend && go run ./cmd/derivekey  (вставить токен бота)
MAX_INITDATA_SECRET=

# Необязательно — есть рабочие значения по умолчанию для локального запуска
# JWT_SECRET=            # минимум 32 символа
# INTERNAL_API_KEY=
# POSTGRES_PASSWORD=

# Демо-вход по кодовому слову (для жюри, в обход обычной регистрации) —
# см. /internal/demo-register. Пусто = демо-режим выключен. После проверки
# просто уберите значение и передеплойте бэкенд.
# DEMO_CODE_WORD=
