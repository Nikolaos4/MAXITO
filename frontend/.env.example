# true — данные из localStorage (демо без бэкенда), false — реальный API
VITE_USE_MOCK=true
# Адрес бэкенда (для dev проксируется через vite на /api)
VITE_API_BASE_URL=/api/v1
# Только для теста реального API вне MAX: телефон, которым привязывается
# max_user_id при первом запросе (X-Max-User-Phone). Внутри MAX не нужен —
# бот привязывает телефон сам. Номер должен быть уже заведён в БД (представителем/CSV).
VITE_DEV_PHONE=
